# Private file: copy to .env.bot (mode 600). Never commit credentials.
BOT_DOMAIN=
BOT_DOCKER_NETWORK=mira-tv-bot
BOT_PORT=8090
MIRA_TV_API_BASE_URL=http://app:8080
BOT_INTERNAL_API_TOKEN=
BOT_OFFLINE_CONFIRM_SECONDS=120
BOT_NOTIFY_RECOVERY=true
BOT_SUPPRESS_DUPLICATES=true

TELEGRAM_BOT_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
TELEGRAM_WEBHOOK_PATH=/webhooks/telegram
TELEGRAM_WEBHOOK_SECRET=

MAX_BOT_ENABLED=false
MAX_BOT_TOKEN=
MAX_ADMIN_ID=
MAX_WEBHOOK_PATH=/webhooks/max
MAX_WEBHOOK_SECRET=
MAX_BOT_USERNAME=
