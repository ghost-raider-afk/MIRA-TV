# Независимая конфигурация MIRA-TV.
# Создаётся автоматически скриптом menu-tv-2.sh при установке.
# Все значения runtime берутся только из этого файла; в коде нет дублирующих дефолтов.

# Базовые параметры приложения.
APP_NAME=MIRA-TV
NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# Публичный HTTPS-домен запрашивается установщиком.
MENU_TV_2_DOMAIN=

# Телевизоры используют SFTP через CX Проводник. Применяется тот же домен,
# но у SFTP собственный TCP-порт, он не проходит через HTTPS.
SFTP_PUBLIC_HOST=
SFTP_PORT=2022
SFTP_API_URL=http://sftp:8080
SFTP_API_TIMEOUT_MS=5000
SFTP_STORAGE_ROOT=/srv/menu-tv-sftp
SFTP_STAGING_MAX_AGE_HOURS=24
# Внутренние служебные данные — не передавайте их телевизорам.
SFTP_ADMIN_USERNAME=menu_tv_2_service
SFTP_ADMIN_PASSWORD=replace-with-generated-sftp-admin-password
GENERATED_PASSWORD_LENGTH=10

# Данные только для собственной базы PostgreSQL этого приложения.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=menu_tv_2
POSTGRES_USER=menu_tv_2
POSTGRES_PASSWORD=replace-with-generated-database-password
POSTGRES_POOL_MAX=5
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_IDLE_TIMEOUT_MS=30000

# Начальная учётная запись создаётся только при пустой базе, после успешного
# запуска переносится в PostgreSQL и эти строки удаляются установщиком.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=32

# Настройки безопасности сессии и ограничения входа задаются только здесь.
SESSION_SECRET=replace-with-generated-session-secret
SESSION_TTL_HOURS=12
SECURE_COOKIES=true
LOGIN_MAX_ATTEMPTS=8
LOGIN_IP_MAX_ATTEMPTS=32
LOGIN_WINDOW_MINUTES=15
LOGIN_LIMITER_MAX_ENTRIES=500

# Активация ТВ: короткая заявка через QR/6-значный код и отдельная долгоживущая
# Device Session. Токен TV хранится у телевизора только в HttpOnly cookie,
# а сервер хранит только его SHA-256 хеш.
DEVICE_ACTIVATION_TTL_MINUTES=2
DEVICE_ACTIVATION_POLL_SECONDS=2
DEVICE_ACTIVATION_MAX_ATTEMPTS=20
DEVICE_ACTIVATION_WINDOW_MINUTES=10
DEVICE_ACTIVATION_LIMITER_MAX_ENTRIES=10000
DEVICE_ACTIVATION_CLEANUP_MINUTES=15
DEVICE_ACTIVATION_RETENTION_HOURS=24
DEVICE_SESSION_TTL_DAYS=365
DEVICE_HEARTBEAT_WRITE_SECONDS=30
PLAYER_REFRESH_SECONDS=5

# Единый журнал событий: действия, предупреждения, ошибки интерфейса/API и системные события.
# Тела запросов, cookies, пароли, токены и другие секреты в журнал не сохраняются.
EVENT_JOURNAL_RETENTION_DAYS=30
EVENT_JOURNAL_MAX_ENTRIES=5000

# Лимиты HTTP и данных редактора.
JSON_BODY_MAX_BYTES=65536
MENU_DRAFT_MAX_BYTES=49152
SCREEN_SOURCE_MAX_BYTES=12582912

# Допустимый диапазон обновления панели и максимальный размер ТВ-макета.
DASHBOARD_REFRESH_MIN_SECONDS=15
DASHBOARD_REFRESH_MAX_SECONDS=300
SCREEN_MAX_WIDTH=1920
SCREEN_MAX_HEIGHT=1080

# Общий лимит декодированного изображения защищает сервер от image-bomb файлов.
IMAGE_MAX_PIXELS=40000000

# Хранилище и лимиты оформления сайта/мониторов. Загрузка доступна только администратору.
SITE_ASSETS_ROOT=/srv/menu-tv-site-assets
SITE_LOGO_MAX_BYTES=2097152
SITE_FAVICON_MAX_BYTES=524288
SCREEN_BACKGROUND_MAX_BYTES=20971520
# Entity может быть видео, поэтому для него отдельный лимит. Файл загружается потоково на диск,
# а не целиком в память процесса приложения.
ENTITY_ASSET_MAX_BYTES=104857600

# Readiness обращается к PostgreSQL, результат кратко кэшируется для защиты DB pool.
HEALTH_READINESS_CACHE_MS=2000

# Ограничения памяти и количества процессов Docker-контейнеров.
# CPU намеренно не квотируется: Docker распределяет доступный процессор между сервисами.
APP_MEMORY_LIMIT=768m
APP_PIDS_LIMIT=256
DB_MEMORY_LIMIT=1g
DB_PIDS_LIMIT=256
SFTP_MEMORY_LIMIT=512m
SFTP_PIDS_LIMIT=256

# Устанавливайте true только для пустого демонстрационного развёртывания.
SEED_DEMO_DATA=false
