# MIRA-TV 1.0.3 — пример единого файла настроек приложения.
APP_NAME=MIRA-TV
MIRA_TV_VERSION=1.0.3
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
MIRA_TV_DOMAIN=
MIRA_TV_ACME_EMAIL=

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=mira_tv
POSTGRES_USER=mira_tv
POSTGRES_PASSWORD=replace-with-generated-database-password
POSTGRES_POOL_MAX=5
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_IDLE_TIMEOUT_MS=30000

BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
GENERATED_PASSWORD_LENGTH=10
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=32
SESSION_SECRET=replace-with-generated-session-secret
SESSION_TTL_HOURS=12
SECURE_COOKIES=true
LOGIN_MAX_ATTEMPTS=8
LOGIN_IP_MAX_ATTEMPTS=32
LOGIN_WINDOW_MINUTES=15
LOGIN_LIMITER_MAX_ENTRIES=500

DEVICE_ACTIVATION_TTL_MINUTES=2
DEVICE_ACTIVATION_POLL_SECONDS=2
DEVICE_ACTIVATION_MAX_ATTEMPTS=20
DEVICE_ACTIVATION_WINDOW_MINUTES=10
DEVICE_ACTIVATION_LIMITER_MAX_ENTRIES=10000
DEVICE_ACTIVATION_CLEANUP_MINUTES=15
DEVICE_ACTIVATION_RETENTION_HOURS=24
DEVICE_SESSION_TTL_DAYS=365
DEVICE_HEARTBEAT_WRITE_SECONDS=60
PLAYER_FALLBACK_POLL_SECONDS=60
PLAYER_LOG_BATCH_SIZE=100
PLAYER_LOG_LOCAL_MAX_ENTRIES=5000
PLAYER_LOG_LOCAL_MAX_BYTES=10485760

# Погодный информер. TV обращается только к MIRA-TV; внешний провайдер используется сервером и кэшируется.
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_SECONDS=900
WEATHER_REQUEST_TIMEOUT_MS=5000
WEATHER_CACHE_MAX_ENTRIES=256
WEATHER_PLAYER_REFRESH_SECONDS=900

EVENT_JOURNAL_RETENTION_DAYS=30
EVENT_JOURNAL_MAX_ENTRIES=5000
JSON_BODY_MAX_BYTES=65536
MENU_DRAFT_MAX_BYTES=49152
SCREEN_SOURCE_MAX_BYTES=12582912
DASHBOARD_REFRESH_MIN_SECONDS=15
DASHBOARD_REFRESH_MAX_SECONDS=300
SCREEN_MAX_WIDTH=1920
SCREEN_MAX_HEIGHT=1080
IMAGE_MAX_PIXELS=40000000
SITE_ASSETS_ROOT=/srv/mira-tv/site-assets
SITE_LOGO_MAX_BYTES=2097152
SITE_FAVICON_MAX_BYTES=524288
SCREEN_BACKGROUND_MAX_BYTES=20971520
ENTITY_ASSET_MAX_BYTES=104857600
MEDIA_IMAGE_MAX_BYTES=20971520
MEDIA_VIDEO_MAX_BYTES=262144000
MEDIA_MAX_WIDTH=11520
MEDIA_MAX_HEIGHT=4320
MEDIA_MAX_PIXELS=50000000
HEALTH_READINESS_CACHE_MS=2000

APP_MEMORY_LIMIT=768m
APP_PIDS_LIMIT=256
DB_MEMORY_LIMIT=1g
DB_PIDS_LIMIT=256
PROXY_MEMORY_LIMIT=256m
PROXY_PIDS_LIMIT=128

SEED_DEMO_DATA=false
